#!/bin/sh
# Validates the commit subject against CONTRIBUTING.md §5 (Conventional Commits).
# Enable once per clone:  git config core.hooksPath .githooks

msg_file="$1"
subject=$(head -n 1 "$msg_file")

# Merge / fixup / squash commits are exempt.
case "$subject" in
  "Merge "*|"fixup!"*|"squash!"*|"Revert "*|"revert "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [a-z0-9].*'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
✖ Commit subject does not follow Conventional Commits.

  <type>(<scope>): <subject>

  types: feat fix docs refactor perf test build ci chore revert
  example: fix(retry): cap backoff at 60s

Rules: imperative mood, lowercase, no trailing period, English, ≤72 chars.
See CONTRIBUTING.md §5.
EOF
  exit 1
fi

if printf '%s' "$subject" | grep -Eq '^.{73,}$'; then
  echo "✖ Commit subject is longer than 72 characters. Put details in the body." >&2
  exit 1
fi

if printf '%s' "$subject" | grep -Eq '\.$'; then
  echo "✖ Commit subject ends with a period. Remove it." >&2
  exit 1
fi

exit 0
